# Per-app secrets/config generated at runtime — never commit these,
# auth_config.json holds the hashed admin password's salt+hash.
# **/ prefix so this matches regardless of depth (e.g. core/admin_dashboard/...).
**/admin_dashboard/config/auth_config.json
**/admin_dashboard/config/recent_projects.json

# Exam workspaces created via "New Workspace" — these are user data
# (nexus_project.json, roster.db, cropped_template.jpg per project),
# not source code.
*.db
*.db-journal

# Exported result sheets
*_Results.xlsx


